DATABASE_URL="file:./dev.db"

# Optional. When set, the app requires this password at /login.
APP_PASSWORD=""

# Optional. HMAC key for session cookies. Defaults to APP_PASSWORD if unset.
SESSION_SECRET=""

# Optional. Required for POST /api/prospects/capture when APP_PASSWORD is set
# (unless the caller already has a session cookie). Also required for capture
# even without APP_PASSWORD if you set a token here.
# Header: x-capture-token: <token>  or  Authorization: Bearer <token>
CAPTURE_TOKEN=""

# Local classifier. Install https://ollama.com then:
#   ollama pull qwen3-coder:30b
# Smaller machines: ollama pull qwen2.5-coder:14b  and set OLLAMA_MODEL to that.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3-coder:30b"

# Optional cloud fallback if Ollama is down. https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen-2.5-coder-32b-instruct"

# Used in the capture bookmarklet. Keep this matching npm run dev.
APP_ORIGIN="http://localhost:6793"
